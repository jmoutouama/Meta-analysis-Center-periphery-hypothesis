cat(sprintf(
'We compiled %d independent studies examining sex-specific trait
responses to environmental stressors in dioecious plants. After
applying inclusion criteria (sampling variance estimable and ≤ 10
for the standard error, and species present in the time-calibrated
phylogeny), the final dataset comprised %d effect sizes (Hedges g,
female minus male) from %d species spanning %d plant families and
%d countries. Effect sizes covered %d distinct response variables
across %d trait categories and %d stressor types. Effect sizes were
computed via four complementary pathways depending on the data
reported in each study: %d from continuous environmental gradient
correlations, %d from categorical treatment contrasts, %d from
pre-reported Pearson correlations, and %d from arcsine-transformed
aggregate sex ratio counts. The median number of effect sizes per
species was %d (range: %d-%d).\n',
n_studies,
n_es,
n_species,
n_families,
n_countries,
n_traits,
n_trait_cat,
n_distinct(effect_sizes_model_ready$stressor_type),
pathway_counts$n[pathway_counts$effect_size_type == "Gradient_r_to_g"],
pathway_counts$n[pathway_counts$effect_size_type == "Treatment_sex_diff_g"],
pathway_counts$n[pathway_counts$effect_size_type == "Reported_r_to_g"],
pathway_counts$n[pathway_counts$effect_size_type == "Asin_r_to_g"],
es_per_species$median_es,
es_per_species$min_es,
es_per_species$max_es
))
# -----------------------------------------------------------------------
# NULL MODEL (intercept only)
#
# Purpose: estimate baseline heterogeneity and variance components
# before adding moderators.
#
# Random effects:
#   gr(Species, cov = phylo_cov_matrix)
#     — phylogenetic random effect. Species sharing more branch length
#       are expected to have more similar effect sizes, accounting for
#       the non-independence of related species.
#
#   (1 | Study_ID:trait_category)
#     — study × trait category random effect (selected by LOO over the
#       full three-level model). Within a study, observations from the
#       same biological system are more similar to each other.
#       This is the key random effect for multilevel meta-analysis when
#       studies contribute multiple response variables.
#
# Prior justification (weakly informative):
#   Normal(0, 1) on Intercept: most meta-analytic effect sizes fall
#     between −2 and +2; this prior is permissive within that range.
#   Half-Cauchy(0, 0.5) on SD: recommended for variance components in
#     hierarchical models (Gelman 2006).
#   Gamma(2, 0.1) on nu: keeps Student-t from collapsing to Cauchy
#     (nu → 1) while allowing heavy tails when needed.
# -----------------------------------------------------------------------
library(brms)
# Model 1: full three-level nesting
model_null_full <- brm(
yi | se(sei) ~ 1 +
(1 | gr(Species, cov = phylo_cov_matrix)) +
(1 | Study_ID) +
(1 | Study_ID:trait_category),
data    = effect_sizes_model_ready,
data2   = list(phylo_cov_matrix = phylo_cov_matrix),
family  = student(),
prior   = c(
prior(normal(0, 1),   class = Intercept),
prior(cauchy(0, 0.5), class = sd),
prior(gamma(2, 0.1),  class = nu)
),
cores   = 4, iter = 4000, warmup = 2000,
control = list(adapt_delta = 0.99, max_treedepth = 15),
seed    = 13
)
# Model 2: drop Study_ID alone — keep only nested term (selected by LOO)
model_null_nested <- brm(
yi | se(sei) ~ 1 +
(1 | gr(Species, cov = phylo_cov_matrix)) +
(1 | Study_ID:trait_category),
data    = effect_sizes_model_ready,
data2   = list(phylo_cov_matrix = phylo_cov_matrix),
family  = student(),
prior   = c(
prior(normal(0, 1),   class = Intercept),
prior(cauchy(0, 0.5), class = sd),
prior(gamma(2, 0.1),  class = nu)
),
cores   = 4, iter = 4000, warmup = 2000,
control = list(adapt_delta = 0.99, max_treedepth = 15),
seed    = 13
)
# Model 3: drop phylogeny — to test whether it matters
model_null_nophylo <- brm(
yi | se(sei) ~ 1 +
(1 | Study_ID) +
(1 | Study_ID:trait_category),
data    = effect_sizes_model_ready,
family  = student(),
prior   = c(
prior(normal(0, 1),   class = Intercept),
prior(cauchy(0, 0.5), class = sd),
prior(gamma(2, 0.1),  class = nu)
),
cores   = 4, iter = 4000, warmup = 2000,
seed    = 13
)
# LOO comparison to select the best null structure
model_null_full    <- add_criterion(model_null_full,    "loo")
model_null_nested  <- add_criterion(model_null_nested,  "loo")
model_null_nophylo <- add_criterion(model_null_nophylo, "loo")
loo_compare(model_null_full, model_null_nested, model_null_nophylo)
# Results:
#                    elpd_diff se_diff
# model_null_nested   0.0       0.0    ← BEST
# model_null_full    -0.4       0.6    ← Study_ID alone adds nothing
# model_null_nophylo -3.8       2.0    ← phylogeny matters (ratio = 1.9 × SE)
# Assign the best null model for all downstream use
model_null <- model_null_nested
# -----------------------------------------------------------------------
# LOO COMPARISON: NULL vs. FULL MODERATOR MODEL
#
# Results:
#            elpd_diff se_diff
# model_null  0.0       0.0
# model_full -5.7       4.0    (ratio = 1.4 × SE, below 2× threshold)
#
# The LOO result means moderators do not improve OUT-OF-SAMPLE PREDICTION
# beyond the null model's random effects. This is expected in meta-analysis:
# heterogeneity is large and random effects already absorb most variance.
# It does NOT mean the moderator estimates are uninformative — it means
# effect size estimation per category is the right goal, not prediction.
#
# We therefore use:
#   model_null — variance decomposition, phylogenetic signal, forest plot
#   model_full — category-specific effect size estimates (Nakagawa et al. 2017)
# -----------------------------------------------------------------------
model_null <- add_criterion(model_null, "loo")
model_full <- add_criterion(model_full, "loo")
# -----------------------------------------------------------------------
# FULL MODERATOR MODEL
#
# Adds two fixed-effect moderators to the null model structure:
#
#   trait_category (11 levels):
#     Cell-means parameterisation (0 + trait_category) gives a direct
#     posterior for each category rather than deviations from a reference
#     level — easier to interpret and report.
#     Tests whether the sex difference in stress response differs across
#     biological systems.
#
#   stressor_type:
#     Tests whether the sex difference is consistent across:
#       Temperature_gradient / Precipitation_gradient /
#       Macroclimate_gradient / Experimental_stress / Discrete_habitat
# -----------------------------------------------------------------------
model_full <- brm(
yi | se(sei) ~ 0 + trait_category + stressor_type +
(1 | gr(Species, cov = phylo_cov_matrix)) +
(1 | Study_ID:trait_category),
data    = effect_sizes_model_ready,
data2   = list(phylo_cov_matrix = phylo_cov_matrix),
family  = student(),
prior   = c(
prior(normal(0, 1),   class = b),
prior(cauchy(0, 0.5), class = sd),
prior(gamma(2, 0.1),  class = nu)
),
cores   = 4,
iter    = 4000,
warmup  = 2000,
control = list(adapt_delta = 0.99, max_treedepth = 15),
seed    = 13
)
# -----------------------------------------------------------------------
# LOO COMPARISON: NULL vs. FULL MODERATOR MODEL
#
# Results:
#            elpd_diff se_diff
# model_null  0.0       0.0
# model_full -5.7       4.0    (ratio = 1.4 × SE, below 2× threshold)
#
# The LOO result means moderators do not improve OUT-OF-SAMPLE PREDICTION
# beyond the null model's random effects. This is expected in meta-analysis:
# heterogeneity is large and random effects already absorb most variance.
# It does NOT mean the moderator estimates are uninformative — it means
# effect size estimation per category is the right goal, not prediction.
#
# We therefore use:
#   model_null — variance decomposition, phylogenetic signal, forest plot
#   model_full — category-specific effect size estimates (Nakagawa et al. 2017)
# -----------------------------------------------------------------------
model_null <- add_criterion(model_null, "loo")
model_full <- add_criterion(model_full, "loo")
cat("=== LOO model comparison (null vs. full) ===\n")
cat("Threshold for meaningful improvement: |elpd_diff| > 2 × se_diff\n\n")
loo_compare(model_null, model_full)
loo_result <- loo_compare(model_null, model_full)
elpd_d     <- loo_result[2, "elpd_diff"]
se_d       <- loo_result[2, "se_diff"]
cat(sprintf(
"\nelpd_diff = %.1f | se_diff = %.1f | ratio = %.2f\n%s\n",
elpd_d, se_d, abs(elpd_d / se_d),
ifelse(abs(elpd_d / se_d) > 2,
"→ Full model meaningfully better for prediction (ratio > 2)",
"→ Moderators do not improve prediction (ratio < 2)\n  Use null for variance decomposition; full for category-specific estimates"
)
))
# -----------------------------------------------------------------------
# Posterior predictive check for null and full models.
# Assesses whether simulated data from the fitted model match the
# distribution of the observed effect sizes.
# -----------------------------------------------------------------------
library(bayesplot)
ppc_null <- pp_check(model_null, type = "dens_overlay", ndraws = 50) +
labs(title = "Null model (selected by LOO)",
x = "Effect size (Hedges' g, female − male)", y = "Density") +
xlim(-50, 50) +
theme_classic(base_size = 12)
ppc_full <- pp_check(model_full, type = "dens_overlay", ndraws = 50) +
labs(title = "Full moderator model (exploratory)",
x = "Effect size (Hedges' g, female − male)", y = "Density") +
xlim(-50, 50) +
theme_classic(base_size = 12)
library(patchwork)
ppc_null + ppc_full
# -----------------------------------------------------------------------
# EGGER'S TEST (Bayesian version)
#
# Regresses effect size (yi) on its standard error (sei).
# Under no publication bias, the slope on sei should be near zero.
# A significantly positive slope indicates "small-study effects":
# studies with fewer observations (larger SE) report inflated effect
# sizes, consistent with selective reporting of significant results.
#
# The phylogenetic and study random effects are retained to avoid
# confounding publication bias with phylogenetic signal or study
# clustering.
# -----------------------------------------------------------------------
model_egger <- brm(
formula = yi | se(sei) ~ sei +
(1 | gr(Species, cov = phylo_cov_matrix)) +
(1 | Study_ID),
data    = effect_sizes_model_ready,
data2   = list(phylo_cov_matrix = phylo_cov_matrix),
family  = student(),
prior   = c(
prior(normal(0, 1),   class = Intercept),
prior(normal(0, 1),   class = b),
prior(cauchy(0, 0.5), class = sd),
prior(gamma(2, 0.1),  class = nu)
),
chains  = 4, cores = 4, iter = 4000, warmup = 2000,
seed    = 13,
file    = file.path(output_dir, "model_egger")
)
cat("=== Egger's test — coefficient on sei ===\n")
cat("A 95% CI excluding zero suggests publication bias.\n\n")
summary(model_egger)
# Funnel plot
ggplot(effect_sizes_model_ready,
aes(x = yi, y = 1 / sei, colour = trait_category)) +
geom_point(alpha = 0.6, size = 2) +
geom_vline(xintercept = 0, linetype = "dashed", colour = "grey40") +
scale_colour_viridis_d(name = "Trait category", option = "turbo") +
labs(x = "Effect size (Hedges' g, female − male)",
y = "Precision (1 / SE)") +
xlim(-5, 5) +
theme_classic(base_size = 11) +
theme(legend.position = "right")
# -----------------------------------------------------------------------
# Species-level posterior distributions from the null model.
#
# Each species posterior:
#   total_effect = grand mean (b_Intercept) + species deviation (r_Species)
#
# The "Pooled Effect" row shows the overall grand mean with 95% CI.
# -----------------------------------------------------------------------
library(tidybayes)
library(ggridges)
library(ggdist)
library(forcats)
# Shared Ecology Letters theme
theme_el <- theme_classic(base_size = 11, base_family = "Arial") +
theme(
axis.line   = element_line(linewidth = 0.4),
axis.ticks  = element_line(linewidth = 0.3),
axis.text   = element_text(size = 10, colour = "black"),
axis.title  = element_text(size = 11),
plot.tag    = element_text(size = 11, face = "plain"),
legend.position = "none"
)
species_posterior_draws <- model_null %>%
spread_draws(r_Species[Species, Intercept], b_Intercept) %>%
mutate(species_effect = b_Intercept + r_Species,
effect_type    = "Species")
pooled_posterior_draws <- model_null %>%
spread_draws(b_Intercept) %>%
mutate(Species        = "Pooled Effect",
species_effect = b_Intercept,
effect_type    = "Pooled")
species_plot_data <- species_posterior_draws %>%
mutate(display_label = reorder(Species, species_effect, median),
effect_type   = "Species")
forest_plot_data <- bind_rows(
species_plot_data %>% select(display_label, species_effect, effect_type),
pooled_posterior_draws %>%
mutate(display_label = "Pooled Effect", effect_type = "Pooled") %>%
select(display_label, species_effect, effect_type)
) %>%
mutate(
display_label = as.character(display_label),
display_label = fct_relevel(display_label, "Pooled Effect", after = Inf)
)
forest_summary_stats <- forest_plot_data %>%
group_by(display_label, effect_type) %>%
median_qi(species_effect) %>%
ungroup() %>%
rename(median_effect = species_effect)
p_forest <- ggplot(forest_plot_data,
aes(x = species_effect, y = display_label, fill = effect_type)) +
geom_vline(xintercept = 0, colour = "grey30", linewidth = 0.4,
linetype = "dashed") +
geom_density_ridges(rel_min_height = 0.01, col = NA,
scale = 0.9, alpha = 0.7) +
geom_pointinterval(
data        = forest_summary_stats,
aes(x = median_effect, xmin = .lower, xmax = .upper, colour = effect_type),
linewidth   = 0.8, orientation = "y"
) +
geom_text(
data  = forest_summary_stats %>%
mutate(across(where(is.numeric), ~ round(., 2))),
aes(label = glue("{median_effect} [{.lower}, {.upper}]"),
x     = max(forest_summary_stats$.upper) + 0.4),
hjust = 0, size = 2.7, colour = "grey20"
) +
scale_y_discrete(
limits = rev(levels(forest_plot_data$display_label)),
labels = NULL, breaks = NULL,
expand = expansion(add = 0.75)
) +
scale_fill_manual(
values = c("Species" = "#E69F00", "Pooled" = "#56B4E9"), name = NULL
) +
scale_colour_manual(
values = c("Species" = "#E69F00", "Pooled" = "#56B4E9"), name = NULL
) +
labs(x = "Effect size (Hedges' g, female − male)", y = NULL) +
theme_classic(base_size = 11, base_family = "Arial") +
theme(legend.position = c(0.10, 0.8),
axis.line  = element_line(linewidth = 0.4),
axis.ticks = element_line(linewidth = 0.3))
p_forest
ggsave(
file.path(output_dir, "Figure_forest_plot.tiff"),
plot = p_forest, device = "tiff",
width = 174, height = 200, units = "mm", dpi = 600, compression = "lzw"
)
ggsave(
file.path(output_dir, "Figure_forest_plot.pdf"),
plot = p_forest, width = 174, height = 200, units = "mm"
)
# -----------------------------------------------------------------------
# Category-specific effect size estimates from the full moderator model.
#
# Answers Q2: "Does the sex difference in stress response vary by trait
# category and stressor type?"
#
# The cell-means parameterisation (0 + trait_category + stressor_type)
# means each coefficient IS the estimated mean Hedges' g for that category,
# directly comparable to zero.
#
#   Positive → females more strongly affected (SDH direction)
#   Negative → males more strongly affected
#   95% CI excluding zero → credible sex difference for that category
# -----------------------------------------------------------------------
library(posterior)
trait_params    <- as_draws_df(model_full) %>%
select(starts_with("b_trait_category")) %>% names()
stressor_params <- as_draws_df(model_full) %>%
select(starts_with("b_stressor_type")) %>% names()
message("Trait category parameters found: ", paste(trait_params, collapse = ", "))
message("Stressor type parameters found:  ", paste(stressor_params, collapse = ", "))
moderator_label_map <- c(
"b_trait_categorySex_ratio"          = "Sex ratio",
"b_trait_categoryWater_relations"    = "Water relations",
"b_trait_categoryPhotosynthesis"     = "Photosynthesis",
"b_trait_categoryPigments"           = "Pigments",
"b_trait_categoryOxidative_stress"   = "Oxidative stress",
"b_trait_categoryCarbon_reserves"    = "Carbon reserves",
"b_trait_categoryGrowth"             = "Growth",
"b_trait_categoryPlant_morphology"   = "Plant morphology",
"b_trait_categoryReproduction"       = "Reproduction",
"b_trait_categoryDemography"         = "Demography",
"b_trait_categoryMycorrhizal"        = "Mycorrhizal",
"b_stressor_typeTemperature_gradient"   = "Temperature gradient",
"b_stressor_typePrecipitation_gradient" = "Precipitation gradient",
"b_stressor_typeExperimental_stress"    = "Experimental stress",
"b_stressor_typeMacroclimate_gradient"  = "Macroclimate gradient",
"b_stressor_typeDiscrete_habitat"       = "Discrete habitat",
"b_stressor_typeUnclassified"           = "Unclassified"
)
moderator_draws <- as_draws_df(model_full) %>%
select(starts_with("b_trait_category"), starts_with("b_stressor_type")) %>%
pivot_longer(cols = everything(), names_to = ".variable", values_to = ".value") %>%
mutate(
coefficient_label = recode(.variable, !!!moderator_label_map),
coefficient_label = if_else(
coefficient_label == .variable,
str_remove(.variable, "^b_(trait_category|stressor_type)"),
coefficient_label
),
moderator_group = if_else(
str_detect(.variable, "trait_category"), "Trait category", "Stressor type"
)
)
p_moderator <- ggplot(moderator_draws,
aes(x = .value, y = reorder(coefficient_label, .value, median))) +
stat_halfeye(
.width       = c(0.80, 0.95),
fill         = "#56B4E9",
colour       = "#2166AC",
alpha        = 0.85,
point_colour = "black",
point_size   = 2,
interval_size_range = c(0.6, 1.2)
) +
geom_vline(xintercept = 0, linetype = "dashed",
colour = "grey30", linewidth = 0.4) +
facet_wrap(~ moderator_group, scales = "free_y", ncol = 2) +
labs(x = "Effect size (Hedges' g, female − male)", y = NULL) +
theme_classic(base_size = 11, base_family = "Arial") +
theme(
axis.line        = element_line(linewidth = 0.4),
axis.ticks       = element_line(linewidth = 0.3),
axis.text        = element_text(size = 10, colour = "black"),
strip.background = element_blank(),
strip.text       = element_text(face = "bold", size = 11)
)
p_moderator
ggsave(
file.path(output_dir, "Figure_moderator_coefficients.tiff"),
plot = p_moderator, device = "tiff",
width = 174, height = 120, units = "mm", dpi = 600, compression = "lzw"
)
ggsave(
file.path(output_dir, "Figure_moderator_coefficients.pdf"),
plot = p_moderator, width = 174, height = 120, units = "mm"
)
p_forest <- ggplot(forest_plot_data,
aes(x = species_effect, y = display_label, fill = effect_type)) +
geom_vline(xintercept = 0, colour = "grey30", linewidth = 0.4,
linetype = "dashed") +
geom_density_ridges(rel_min_height = 0.01, col = NA,
scale = 0.9, alpha = 0.7) +
geom_pointinterval(
data        = forest_summary_stats,
aes(x = median_effect, xmin = .lower, xmax = .upper, colour = effect_type),
linewidth   = 0.8, orientation = "y"
) +
geom_text(
data  = forest_summary_stats %>%
mutate(across(where(is.numeric), ~ round(., 2))),
aes(label = glue("{median_effect} [{.lower}, {.upper}]"),
x     = max(forest_summary_stats$.upper) + 0.4),
hjust = 0, size = 2.7, colour = "grey20"
) +
scale_y_discrete(
limits = rev(levels(forest_plot_data$display_label)),
labels = NULL, breaks = NULL,
expand = expansion(add = 0.75)
) +
scale_fill_manual(
values = c("Species" = "#E69F00", "Pooled" = "#56B4E9"), name = NULL
) +
scale_colour_manual(
values = c("Species" = "#E69F00", "Pooled" = "#56B4E9"), name = NULL
) +
labs(x = expression(paste("Effect size (Hedges' ", italic(g), ")")), y = NULL) +
theme_classic(base_size = 11, base_family = "Arial") +
theme(legend.position = c(0.10, 0.8),
axis.line  = element_line(linewidth = 0.4),
axis.ticks = element_line(linewidth = 0.3))
p_forest
p_moderator <- ggplot(moderator_draws,
aes(x = .value, y = reorder(coefficient_label, .value, median))) +
stat_halfeye(
.width       = c(0.80, 0.95),
fill         = "#56B4E9",
colour       = "#2166AC",
alpha        = 0.85,
point_colour = "black",
point_size   = 2,
interval_size_range = c(0.6, 1.2)
) +
geom_vline(xintercept = 0, linetype = "dashed",
colour = "grey30", linewidth = 0.4) +
facet_wrap(~ moderator_group, scales = "free_y", ncol = 2) +
labs(x = expression(paste("Effect size (Hedges' ", italic(g), ")")), y = NULL) +
theme_classic(base_size = 11, base_family = "Arial") +
theme(
axis.line        = element_line(linewidth = 0.4),
axis.ticks       = element_line(linewidth = 0.3),
axis.text        = element_text(size = 10, colour = "black"),
strip.background = element_blank(),
strip.text       = element_text(face = "bold", size = 11)
)
p_moderator
effect_sizes_model_ready
